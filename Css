body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f3f6;
    text-align: center;
}

.welcome-screen {
    padding: 40px;
}

.welcome-screen h1 {
    font-size: 32px;
    color: #333;
}

.welcome-screen span {
    color: #4CAF50;
    font-weight: bold;
}

.welcome-screen button {
    padding: 12px 25px;
    background: #4CAF50;
    border: none;
    color: white;
    font-size: 18px;
    cursor: pointer;
    border-radius: 8px;
}

.hidden {
    display: none;
}

.app {
    padding: 20px;
}

form input, form button {
    display: block;
    margin: 10px auto;
    padding: 10px;
    width: 80%;
    font-size: 16px;
}

form button {
    background: #4CAF50;
    border: none;
    color: white;
    cursor: pointer;
    border-radius: 6px;
}

#taskList {
    list-style: none;
    padding: 0;
}

#taskList li {
    background: #ffffff;
    padding: 12px;
    margin: 8px auto;
    width: 80%;
    border-radius: 8px;
    box-shadow: 0px 2px 5px rgba(0,0,0,0.1);
}
